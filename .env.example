# Clash-Realtime Production Environment Template
# =================================================
#
# THIS FILE IS COMMITTED (safe — no secrets).
# Real .env.production lives on the VM at /opt/clash-realtime/.env.production
# and is gitignored.
#
# To create it on the VM, run:
#   sudo bash deploy/add-supabase-env.sh
#
# (script prompts for SUPABASE_SERVICE_ROLE_KEY, auto-generates GAME_SERVER_SECRET)
#

# ─── Clash-Onchain Supabase project ─────────────────────────────
# Dashboard: https://supabase.com/dashboard/project/ktrwdkrxsttdadqvudco
SUPABASE_URL=https://ktrwdkrxsttdadqvudco.supabase.co

# ⚠️ service_role key (NOT anon) — has full DB write access.
# Get from: Dashboard → Settings → API → service_role (click "reveal")
# Required for: recordMatchToServerSide (game server → record-match edge fn)
SUPABASE_SERVICE_ROLE_KEY=eyJ...REPLACE_ME

# ─── M2M secret for record-match edge function ───────────────────
# Must match the value set in:
#   Supabase Dashboard → Edge Functions → Secrets → GAME_SERVER_SECRET
# Generate fresh: openssl rand -hex 32
# (deploy/add-supabase-env.sh auto-generates this if not provided)
GAME_SERVER_SECRET=REPLACE_WITH_OUTPUT_OF_openssl_rand_hex_32

# ─── Privy (human auth) ─────────────────────────────────────────
# Required in production IF ALLOW_ANON_USERS != true.
# Get from: https://dashboard.privy.io → Your App → Settings → App ID/Secret
# For agent-only mode, set ALLOW_ANON_USERS=false and leave these blank.
PRIVY_APP_ID=
PRIVY_APP_SECRET=

# ─── Auth mode ──────────────────────────────────────────────────
# false = require real auth (Privy JWT for humans, clash_* API key for agents)
# true  = accept any token/wallet (DEV ONLY — never enable in real production)
ALLOW_ANON_USERS=false

# ─── Server ports ────────────────────────────────────────────────
# 2567 = Colyseus WebSocket + HTTP (game server)
# (Caddy reverse-proxies ws.clashonchain.xyz:443 → 2567)
PORT=2567

# ─── Optional tuning ────────────────────────────────────────────
# How long to wait in queue for a 2nd human player before falling
# back to AI bot. Default 20s.
# MATCHMAKING_TIMEOUT_MS=20000

# How long an empty BattleRoom can sit before being disposed.
# Default 60s. Prevents room leaks when matchmaking handoff fails.
# EMPTY_ROOM_TIMEOUT_MS=60000
