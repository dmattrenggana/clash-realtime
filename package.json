{
  "private": true,
  "name": "clash-realtime",
  "version": "0.17.0",
  "description": "Colyseus server-authoritative realtime battle engine for Clash Onchain",
  "type": "module",
  "main": "build/index.js",
  "engines": {
    "node": ">= 20.9.0"
  },
  "scripts": {
    "start": "tsx watch src/index.ts",
    "loadtest": "tsx loadtest/example.ts --room battle --numClients 2",
    "build": "npm run clean && tsc -p tsconfig.build.json",
    "clean": "rimraf build",
    "test": "tsc -p tsconfig.json --outDir build && mocha build/test/**.test.js --exit --timeout 15000"
  },
  "author": "",
  "license": "UNLICENSED",
  "devDependencies": {
    "@colyseus/loadtest": "^0.17.7",
    "@colyseus/sdk": "^0.17.17",
    "@colyseus/testing": "^0.17.10",
    "@types/express": "^4.17.1",
    "@types/mocha": "^10.0.1",
    "mocha": "^11.7.5",
    "rimraf": "^5.0.0",
    "tsx": "^4.21.0",
    "typescript": "^5.0.4"
  },
  "dependencies": {
    "@colyseus/schema": "^4.0.0",
    "@colyseus/tools": "^0.17.0",
    "@privy-io/server-auth": "^1.32.0",
    "@supabase/supabase-js": "^2.108.1",
    "colyseus": "^0.17.6",
    "dotenv": "^17.4.2",
    "express": "^4.18.2",
    "viem": "^2.53.1",
    "zod": "^4.1.12"
  }
}
